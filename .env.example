# =====================================================================
# EQUILIBRA — Complete System Environment & Credential Template
# Copy to .env. Never commit real sponsor credentials or private keys.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Database & Core Infrastructure
# ---------------------------------------------------------------------
DB_PASSWORD=enigma_local_only
DATABASE_URL=postgresql://enigma:enigma_local_only@localhost:5433/enigma
DATA_DIR=/app/data
# 'fixture' = self-contained local dev DB; 'zetaris' = live federated queries
FINANCE_SOURCE=fixture

# ---------------------------------------------------------------------
# 2. AI Provider Selection & Failover Architecture
# Order: Meterless Nightshift -> NVIDIA NIM Hosted API -> Offline Deterministic
# ---------------------------------------------------------------------
AI_PROVIDER=meterless
AI_FALLBACK_ORDER=meterless,nim,offline

# Meterless Nightshift (Primary Provider when healthy)
METERLESS_BASE_URL=http://host.docker.internal:8088/v1
METERLESS_TOKEN=
METERLESS_MODEL=meterless/auto
METERLESS_TIMEOUT_SECONDS=180

# NVIDIA NIM Hosted API (Secondary Failover Provider)
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_NIM_TIMEOUT_SECONDS=60

# Offline Fallback Settings
AI_OFFLINE_FALLBACK=true
AI_MAX_RETRIES_PER_PROVIDER=1

# ---------------------------------------------------------------------
# 3. Zetaris Cloud SQL Federation (Independent Data Layer — NOT AI Inference)
# ---------------------------------------------------------------------
ZETARIS_BASE_URL=http://host.docker.internal:8888/api/v1.0
ZETARIS_AUTH_URL=http://host.docker.internal:3000/api/auth/login
ZETARIS_ADMIN_EMAIL=admin@zetaris.com
ZETARIS_ADMIN_PASSWORD=
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1
ZETARIS_INVOICE_VIEW=enigma_invoices
ZETARIS_PAYMENT_VIEW=enigma_payments
ZETARIS_BANK_VIEW=enigma_bank_transactions

# ---------------------------------------------------------------------
# 4. SMTP Email Delivery (Durable Resident & Vendor Notifications)
# ---------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@equilibra.ai
SMTP_FROM_NAME="EQUILIBRA Property Operations"
SMTP_USE_TLS=true

# ---------------------------------------------------------------------
# 5. Twilio SMS Carrier (Field Technician Emergency Dispatch)
# ---------------------------------------------------------------------
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------
# 6. Payment Processing Gateway & ACH Banking (Stripe / Plaid)
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ---------------------------------------------------------------------
# 7. Document Intelligence & Optical Character Recognition (PaddleOCR)
# ---------------------------------------------------------------------
# PaddleOCR runs 100% locally on your machine / container — no API key is required.
OCR_ENABLED=true
OCR_PROVIDER=paddleocr
OCR_LANG=en
OCR_USE_ANGLE_CLS=true
# ---------------------------------------------------------------------
# 8. Semantic Vector Embeddings & RAG Configuration
# ---------------------------------------------------------------------
EMBEDDING_PROVIDER=meterless
EMBEDDING_MODEL=meterless/auto
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_DIMENSION=384

# ---------------------------------------------------------------------
# 9. Security, JWT Tokens & Application Secrets
# ---------------------------------------------------------------------
SECRET_KEY=equilibra_dev_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------
# 9. Execution Timeouts & Guardrail Limits
# ---------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=30
MAX_AGENT_ROUNDS=3
